# Any LiteLLM model string. Your edge function used xAI, so e.g. xai/<model-id> with XAI_API_KEY
LLM_MODEL=xai/grok-2-latest
XAI_API_KEY=
# OPENAI_API_KEY=  /  ANTHROPIC_API_KEY=

# Supabase (SERVER ONLY - the service_role key bypasses RLS, never put it in the frontend)
SUPABASE_URL=https://ufoihbshdqxgrycbtiri.supabase.co
SUPABASE_SERVICE_KEY=

# Frontend origin(s) allowed to call the agent API, comma separated
CORS_ORIGINS=http://localhost:5173
SYNC_INTERVAL=60

# Nothing is posted to X unless this is false
DRY_RUN=true
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

VERBOSE=false
MAX_PARALLEL=3
MAX_REVISIONS=3
AUTO_APPROVE_CONFIDENCE=0
